root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_size = 2
indent_style = space
max_line_length = 120
trim_trailing_whitespace = true

[*.{diff,patch}]
trim_trailing_whitespace = false
insert_final_newline = unset

[*.adoc]
indent_size = unset

[*.css]
indent_style = unset

[*.{desktop,sh}]
max_line_length = unset

[*.{adoc,conf,envrc,lock,nix,nu,rules,yaml,yml}]
max_line_length = off

[{justfile,.justfile,*.just}]
indent_size = 4

[*.lua]
indent_size = 4
# Comments and log messages are often long, and StyLua handles line length for code.
max_line_length = off
